# Maintainer: Shawn Squire <shawn@shawnsquire.me>
#
# Template for the [ktn-yeetbin] pacman repository. The workflow substitutes @PKGVER@
# and builds against a source tarball it assembles from the checkout, so the package is
# built from the exact commit rather than a published tag.
#
# The AUR PKGBUILD in ../aur builds the same program from a release tarball instead.
pkgname=yeetbin-app
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Yeet a file or stdin at a yeetbin instance and get a shareable link back"
arch=('x86_64')
url="https://github.com/Kautiontape/yeetbin-app"
license=('MIT')
depends=('glibc')
makedepends=('go')
# Installs /usr/bin/yeet, which the unrelated 'yeet' pacman wrapper also owns.
conflicts=('yeet')
# Without this, makepkg splits debug symbols into a second yeetbin-app-debug package.
# The repo only wants the program, and a stray second package is easy to index by
# mistake.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$srcdir"
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	# Stamp the package version so 'yeet --version' matches what pacman reports.
	go build -ldflags "-linkmode=external -X main.version=$pkgver" -o yeet .
}

check() {
	cd "$srcdir"
	export GOFLAGS="-trimpath -mod=readonly -modcacherw"
	go test ./...
}

package() {
	cd "$srcdir"
	install -Dm755 yeet "$pkgdir/usr/bin/yeet"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
